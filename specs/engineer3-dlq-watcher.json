{
  "type": "monitor",
  "name": "NDR DLQ Volume Spike Watcher",
  "monitor_type": "query_level_monitor",
  "enabled": true,
  "schedule": {
    "period": { "interval": 1, "unit": "MINUTES" }
  },
  "inputs": [
    {
      "search": {
        "indices": ["ndr-dlq-bad-schema-*"],
        "query": {
          "size": 0,
          "query": {
            "range": {
              "@timestamp": { "gte": "now-1m", "lte": "now" }
            }
          },
          "aggs": {
            "dlq_volume": { "value_count": { "field": "_id" } },
            "dlq_by_reason": { "terms": { "field": "labels.dlq_reason.keyword", "size": 10 } },
            "by_source": { "terms": { "field": "source.ip", "size": 5 } }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "name": "DLQ Spike — Schema Attack or Bad Deploy",
      "severity": "1",
      "condition": {
        "script": {
          "lang": "painless",
          "source": "ctx.results[0].aggregations.dlq_volume.value > 100"
        }
      }
    }
  ]
}
